# Copy to .container/proxmox.env and replace placeholders with real values.
# Do not commit .container/proxmox.env.

# Optional: override the OWL image or localhost host port used by docker-compose.proxmox.yml.
OWL_IMAGE=mugglejinx/owl:latest
OWL_HOST_PORT=7860

# OWL model/API keys. Fill only the providers you use.
OPENAI_API_KEY=replace_with_openai_api_key
OPENAI_API_BASE_URL=
QWEN_API_KEY=replace_with_qwen_api_key
QWEN_API_BASE_URL=
DEEPSEEK_API_KEY=replace_with_deepseek_api_key
DEEPSEEK_API_BASE_URL=
GROQ_API_KEY=replace_with_groq_api_key
GROQ_API_BASE_URL=
AZURE_OPENAI_API_KEY=replace_with_azure_openai_api_key
AZURE_OPENAI_BASE_URL=
AZURE_API_VERSION=
AZURE_DEPLOYMENT_NAME=
GEMINI_API_KEY=replace_with_gemini_api_key

# OWL tools/services. Fill only the tools you use.
GOOGLE_API_KEY=replace_with_google_api_key
SEARCH_ENGINE_ID=replace_with_search_engine_id
CHUNKR_API_KEY=replace_with_chunkr_api_key
FIRECRAWL_API_KEY=replace_with_firecrawl_api_key
FIRECRAWL_API_URL=https://api.firecrawl.dev

# Optional Proxmox MCP API sidecar. Required only when using docker-compose.proxmox-mcp.yml.
PROXMOX_MCP_API_IMAGE=replace_with_proxmox_mcp_api_image
PROXMOX_API_KEY=replace_with_proxmox_api_key
MCPO_CORS_ALLOW_ORIGINS=https://s1.garza.online,http://s1.garza.online,https://mcp.garza.online,http://mcp.garza.online
